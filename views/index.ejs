<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'WhatsApp Multi-Session Bot' %></title>

  <!-- Tailwind CSS (CDN) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- QRCode.js (CDN) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            },
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'Menlo', 'monospace'],
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease-in-out',
            'slide-up': 'slideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1)',
            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'shimmer': 'shimmer 2s linear infinite',
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' },
            },
            slideUp: {
              '0%': { opacity: '0', transform: 'translateY(20px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            },
            shimmer: {
              '0%': { backgroundPosition: '-200% 0' },
              '100%': { backgroundPosition: '200% 0' },
            },
          },
        },
      },
    };
  </script>

  <style>
    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.03); }
    ::-webkit-scrollbar-thumb {
      background: rgba(96, 165, 250, 0.3);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(96, 165, 250, 0.5); }

    /* Animated gradient background */
    .bg-animated {
      background:
        radial-gradient(ellipse at top left, rgba(59, 130, 246, 0.18), transparent 45%),
        radial-gradient(ellipse at bottom right, rgba(6, 182, 212, 0.15), transparent 45%),
        radial-gradient(ellipse at center, rgba(99, 102, 241, 0.1), transparent 60%),
        linear-gradient(180deg, #0a0a1a 0%, #0d1024 100%);
      background-size: 100% 100%;
    }

    /* Grid overlay */
    .grid-overlay {
      background-image:
        linear-gradient(rgba(96, 165, 250, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(96, 165, 250, 0.04) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    }

    /* Floating orbs */
    .orb {
      position: absolute;
      border-radius: 9999px;
      filter: blur(90px);
      opacity: 0.45;
      animation: float 20s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(40px, -30px) scale(1.08); }
      66% { transform: translate(-30px, 25px) scale(0.95); }
    }

    /* Glass card */
    .glass {
      background: rgba(255, 255, 255, 0.035);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* QR container fix */
    #qrContainer canvas,
    #qrContainer img {
      border-radius: 12px;
      display: block;
      margin: 0 auto;
      background: #ffffff;
      padding: 12px;
      box-shadow: 0 10px 40px rgba(59, 130, 246, 0.35);
    }

    /* Fade-in for tab content */
    .tab-content { animation: tabIn 0.35s ease-out; }
    @keyframes tabIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Loading spinner */
    .spinner {
      border: 2.5px solid rgba(255, 255, 255, 0.25);
      border-top-color: #ffffff;
      border-radius: 9999px;
      width: 18px;
      height: 18px;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Pulse ring for status */
    .pulse-ring {
      animation: pulseRing 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulseRing {
      0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); }
      70% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); }
      100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    }

    .pulse-ring-off {
      animation: pulseRingOff 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulseRingOff {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6); }
      70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    /* Code box shimmer */
    .code-shimmer {
      background: linear-gradient(
        90deg,
        rgba(59, 130, 246, 0.08) 0%,
        rgba(59, 130, 246, 0.2) 50%,
        rgba(59, 130, 246, 0.08) 100%
      );
      background-size: 200% 100%;
      animation: shimmer 2.5s linear infinite;
    }

    /* Monospace digits alignment for pair code */
    .pair-code-display {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.25em;
    }
  </style>
</head>

<body class="bg-[#0a0a1a] text-slate-100 font-sans min-h-screen overflow-x-hidden">

  <!-- ============================================= -->
  <!--  BACKGROUND                                   -->
  <!-- ============================================= -->
  <div class="fixed inset-0 bg-animated -z-20"></div>
  <div class="fixed inset-0 grid-overlay -z-10 pointer-events-none"></div>

  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="orb w-[480px] h-[480px] top-[-140px] left-[-120px]"
         style="background: radial-gradient(circle, #3b82f6, transparent 70%);"></div>
    <div class="orb w-[420px] h-[420px] bottom-[-140px] right-[-120px]"
         style="background: radial-gradient(circle, #06b6d4, transparent 70%); animation-delay: -7s;"></div>
    <div class="orb w-[360px] h-[360px] top-[45%] left-[55%]"
         style="background: radial-gradient(circle, #6366f1, transparent 70%); animation-delay: -13s;"></div>
  </div>

  <!-- ============================================= -->
  <!--  MAIN WRAPPER                                 -->
  <!-- ============================================= -->
  <main class="min-h-screen flex flex-col items-center justify-center px-4 py-8 sm:py-12">

    <!-- Brand / Header -->
    <header class="w-full max-w-xl text-center mb-8 animate-fade-in">
      <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 mb-5 rounded-2xl
                  bg-gradient-to-br from-brand-500 to-cyan-500 shadow-lg shadow-brand-500/40
                  animate-pulse-slow">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 sm:w-10 sm:h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight
                 bg-gradient-to-r from-white via-brand-200 to-cyan-200
                 bg-clip-text text-transparent">
        WhatsApp Multi-Session Bot
      </h1>
      <p class="text-sm sm:text-base text-slate-400 mt-3 max-w-md mx-auto leading-relaxed">
        Unganisha namba yako kwa <strong class="text-brand-300">Pairing Code</strong> au
        <strong class="text-brand-300">QR Code</strong> — kwa usalama na urahisi.
      </p>
    </header>

    <!-- ============================================= -->
    <!--  MAIN CARD                                    -->
    <!-- ============================================= -->
    <section class="w-full max-w-xl glass rounded-3xl p-6 sm:p-8
                    shadow-2xl shadow-black/60 relative overflow-hidden
                    animate-slide-up">

      <!-- Top accent line -->
      <div class="absolute top-0 left-[15%] right-[15%] h-px
                  bg-gradient-to-r from-transparent via-brand-400/70 to-transparent"></div>

      <!-- ============================================= -->
      <!--  SESSION ID INPUT                             -->
      <!-- ============================================= -->
      <div class="mb-6">
        <label for="sessionId" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">
          Session ID
        </label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </span>
          <input type="text" id="sessionId" value="default" placeholder="default"
                 class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-white/[0.04]
                        border border-white/10 text-slate-100 font-mono text-sm
                        placeholder-slate-500 outline-none transition-all
                        focus:border-brand-500 focus:bg-brand-500/5
                        focus:ring-4 focus:ring-brand-500/15" />
        </div>
        <p class="mt-2 text-[11px] text-slate-500">
          Acha kama <code class="text-brand-300 font-mono">default</code> kama unaunganisha session moja.
        </p>
      </div>

      <!-- ============================================= -->
      <!--  TABS                                         -->
      <!-- ============================================= -->
      <div class="grid grid-cols-2 gap-1 p-1 rounded-xl bg-white/[0.03] border border-white/8 mb-6">

        <button type="button" id="tabPair" data-tab="pair"
                class="tab-btn flex items-center justify-center gap-2 py-3 rounded-lg
                       text-sm font-semibold transition-all duration-300
                       bg-gradient-to-br from-brand-500 to-cyan-500 text-white
                       shadow-lg shadow-brand-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          Pairing Code
        </button>

        <button type="button" id="tabQR" data-tab="qr"
                class="tab-btn flex items-center justify-center gap-2 py-3 rounded-lg
                       text-sm font-semibold transition-all duration-300
                       text-slate-400 hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
          </svg>
          QR Code
        </button>
      </div>

      <!-- ============================================= -->
      <!--  ALERT AREA                                   -->
      <!-- ============================================= -->
      <div id="alertBox" class="hidden mb-5"></div>

      <!-- ============================================= -->
      <!--  TAB: PAIRING CODE                            -->
      <!-- ============================================= -->
      <div id="panelPair" class="tab-content">
        <div class="mb-5">
          <label for="phoneNumber" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">
            Namba ya Simu
          </label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </span>
            <input type="tel" id="phoneNumber" placeholder="255712345678"
                   inputmode="numeric" pattern="[0-9]*" maxlength="15"
                   class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-white/[0.04]
                          border border-white/10 text-slate-100 font-mono text-sm
                          placeholder-slate-500 outline-none transition-all
                          focus:border-brand-500 focus:bg-brand-500/5
                          focus:ring-4 focus:ring-brand-500/15" />
          </div>
          <p class="mt-2 text-[11px] text-slate-500">
            Weka namba na country code (bila <code class="text-slate-400">+</code>)
          </p>
        </div>

        <button type="button" id="pairBtn"
                class="w-full py-3.5 rounded-xl font-bold text-sm
                       bg-gradient-to-br from-brand-500 to-cyan-500 text-white
                       shadow-lg shadow-brand-500/40 transition-all duration-300
                       hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-500/50
                       active:translate-y-0 disabled:opacity-60 disabled:cursor-not-allowed
                       flex items-center justify-center gap-2.5">
          <span id="pairBtnSpinner" class="spinner hidden"></span>
          <svg id="pairBtnIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <span id="pairBtnText">Pata Pairing Code</span>
        </button>

        <!-- Pair code display -->
        <div id="pairResult" class="hidden mt-6">
          <div class="code-shimmer rounded-2xl p-5 border border-brand-500/40 text-center">
            <div class="text-[11px] font-bold uppercase tracking-widest text-brand-300 mb-3">
              ✅ Pairing Code Yako
            </div>
            <div id="pairCodeValue"
                 class="pair-code-display inline-block px-5 py-3 rounded-xl
                        bg-black/40 border border-brand-500/40
                        text-2xl sm:text-3xl font-black text-brand-200
                        font-mono select-all mb-4">
              ----
            </div>
            <div>
              <button type="button" id="copyCodeBtn"
                      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                             bg-white/5 border border-white/10 text-slate-200
                             text-sm font-semibold transition-all
                             hover:bg-brand-500/20 hover:border-brand-500/50">
                <span id="copyIcon">📋</span>
                <span id="copyLabel">Copy Code</span>
              </button>
            </div>
            <p class="mt-4 text-xs text-slate-400 leading-relaxed">
              Fungua WhatsApp → <strong>Settings</strong> → <strong>Linked Devices</strong>
              → <strong>Link a Device</strong> → <strong>Link with phone number</strong>
            </p>
          </div>
        </div>
      </div>

      <!-- ============================================= -->
      <!--  TAB: QR CODE                                 -->
      <!-- ============================================= -->
      <div id="panelQR" class="tab-content hidden">
        <div id="qrContainer"
             class="min-h-[280px] flex items-center justify-center
                    rounded-2xl bg-white/[0.02] border border-white/8 p-6 relative">
          <div id="qrPlaceholder" class="text-center text-slate-500">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full
                        border-2 border-dashed border-slate-600
                        flex items-center justify-center animate-pulse-slow">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
              </svg>
            </div>
            <p class="text-sm">QR Code itaonekana hapa</p>
            <p class="text-xs text-slate-600 mt-1">
              Subiri muunganisho wa WebSocket...
            </p>
          </div>
        </div>

        <div class="mt-5 p-4 rounded-xl bg-white/[0.02] border border-white/6">
          <div class="text-[11px] font-bold uppercase tracking-widest text-brand-300 mb-2">
            📱 Jinsi ya Kutumia
          </div>
          <ol class="text-xs text-slate-400 space-y-1.5 list-decimal list-inside leading-relaxed">
            <li>Fungua WhatsApp kwenye simu yako</li>
            <li>Nenda <strong>Settings → Linked Devices</strong></li>
            <li>Bonyeza <strong>Link a Device</strong></li>
            <li>Scan QR code hapo juu</li>
          </ol>
        </div>
      </div>

    </section>

    <!-- ============================================= -->
    <!--  STATUS BAR (Fixed Bottom)                    -->
    <!-- ============================================= -->
    <div class="w-full max-w-xl mt-6">
      <div class="glass rounded-2xl px-5 py-3.5 flex items-center justify-between
                  shadow-lg shadow-black/40">
        <div class="flex items-center gap-3">
          <span id="statusDot"
                class="relative w-2.5 h-2.5 rounded-full bg-red-500 pulse-ring-off"></span>
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500 leading-none mb-1">
              Hali ya Session
            </div>
            <div id="statusText" class="text-sm font-semibold text-red-400 leading-none">
              Offline
            </div>
          </div>
        </div>
        <div class="text-right">
          <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500 leading-none mb-1">
            Session
          </div>
          <div id="statusSession" class="text-xs font-mono text-slate-300 leading-none">
            default
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="mt-6 text-center text-[11px] text-slate-600">
      Powered by <span class="text-brand-400 font-semibold">Dvary Bot</span> · Secured with WebSocket
    </footer>

  </main>

  <!-- ============================================= -->
  <!--  JAVASCRIPT                                    -->
  <!-- ============================================= -->
  <script>
    (function () {
      'use strict';

      // ============================================
      //  ELEMENTS
      // ============================================
      const $ = (id) => document.getElementById(id);

      const sessionInput  = $('sessionId');
      const tabPair       = $('tabPair');
      const tabQR         = $('tabQR');
      const panelPair     = $('panelPair');
      const panelQR       = $('panelQR');

      const phoneInput    = $('phoneNumber');
      const pairBtn       = $('pairBtn');
      const pairBtnText   = $('pairBtnText');
      const pairBtnSpinner= $('pairBtnSpinner');
      const pairBtnIcon   = $('pairBtnIcon');

      const pairResult    = $('pairResult');
      const pairCodeValue = $('pairCodeValue');
      const copyCodeBtn   = $('copyCodeBtn');
      const copyIcon      = $('copyIcon');
      const copyLabel     = $('copyLabel');

      const alertBox      = $('alertBox');

      const qrContainer   = $('qrContainer');
      const qrPlaceholder = $('qrPlaceholder');

      const statusDot     = $('statusDot');
      const statusText    = $('statusText');
      const statusSession = $('statusSession');

      // ============================================
      //  STATE
      // ============================================
      let currentTab      = 'pair';
      let currentCode     = '';
      let ws              = null;
      let qrInstance      = null;
      let reconnectTimer  = null;
      let reconnectDelay  = 1500; // start at 1.5s

      // ============================================
      //  ALERT HELPERS
      // ============================================
      const ALERT_ICONS = {
        error:   '❌',
        success: '✅',
        info:    'ℹ️',
        warn:    '⚠️',
      };
      const ALERT_CLASSES = {
        error:   'bg-red-500/10 border-red-500/30 text-red-300',
        success: 'bg-green-500/10 border-green-500/30 text-green-300',
        info:    'bg-brand-500/10 border-brand-500/30 text-brand-200',
        warn:    'bg-amber-500/10 border-amber-500/30 text-amber-300',
      };

      function showAlert(message, type = 'info') {
        const icon = ALERT_ICONS[type] || ALERT_ICONS.info;
        const classes = ALERT_CLASSES[type] || ALERT_CLASSES.info;

        alertBox.innerHTML = `
          <div class="flex items-start gap-3 px-4 py-3 rounded-xl border ${classes}
                      animate-fade-in transition-all">
            <span class="text-base leading-none mt-0.5">${icon}</span>
            <span class="flex-1 text-sm leading-relaxed break-words">${escapeHtml(message)}</span>
          </div>
        `;
        alertBox.classList.remove('hidden');
      }

      function hideAlert() {
        alertBox.classList.add('hidden');
        alertBox.innerHTML = '';
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = String(str);
        return div.innerHTML;
      }

      // ============================================
      //  TAB SWITCHING
      // ============================================
      function setTab(tab) {
        currentTab = tab;
        hideAlert();

        const activeClass =
          'bg-gradient-to-br from-brand-500 to-cyan-500 text-white shadow-lg shadow-brand-500/30';
        const inactiveClass = 'text-slate-400 hover:text-white';

        if (tab === 'pair') {
          tabPair.className = tabPair.className.replace(
            /(text-slate-400 hover:text-white|bg-gradient-to-br from-brand-500 to-cyan-500 text-white shadow-lg shadow-brand-500\/30)/g,
            ''
          ).trim() + ' ' + activeClass;

          tabQR.className = tabQR.className.replace(
            /(text-slate-400 hover:text-white|bg-gradient-to-br from-brand-500 to-cyan-500 text-white shadow-lg shadow-brand-500\/30)/g,
            ''
          ).trim() + ' ' + inactiveClass;

          panelPair.classList.remove('hidden');
          panelQR.classList.add('hidden');
        } else {
          tabQR.className = tabQR.className.replace(
            /(text-slate-400 hover:text-white|bg-gradient-to-br from-brand-500 to-cyan-500 text-white shadow-lg shadow-brand-500\/30)/g,
            ''
          ).trim() + ' ' + activeClass;

          tabPair.className = tabPair.className.replace(
            /(text-slate-400 hover:text-white|bg-gradient-to-br from-brand-500 to-cyan-500 text-white shadow-lg shadow-brand-500\/30)/g,
            ''
          ).trim() + ' ' + inactiveClass;

          panelQR.classList.remove('hidden');
          panelPair.classList.add('hidden');

          // When switching to QR, ensure we have a live socket
          ensureWebSocket();
        }

        // Trigger animation
        const panel = tab === 'pair' ? panelPair : panelQR;
        panel.classList.remove('tab-content');
        void panel.offsetWidth;
        panel.classList.add('tab-content');
      }

      tabPair.addEventListener('click', () => setTab('pair'));
      tabQR.addEventListener('click', () => setTab('qr'));

      // ============================================
      //  PAIR CODE — SUBMIT
      // ============================================
      function validatePhone(phone) {
        const clean = String(phone || '').replace(/[^\d]/g, '');
        if (!clean) return { ok: false, message: 'Weka namba yako ya simu.' };
        if (clean.length < 8) return { ok: false, message: 'Namba ni fupi sana (min 8 digits).' };
        if (clean.length > 15) return { ok: false, message: 'Namba ni ndefu sana (max 15 digits).' };
        return { ok: true, clean };
      }

      function setPairLoading(loading) {
        if (loading) {
          pairBtn.disabled = true;
          pairBtnSpinner.classList.remove('hidden');
          pairBtnIcon.classList.add('hidden');
          pairBtnText.textContent = 'Inatuma...';
        } else {
          pairBtn.disabled = false;
          pairBtnSpinner.classList.add('hidden');
          pairBtnIcon.classList.remove('hidden');
          pairBtnText.textContent = 'Pata Pairing Code';
        }
      }

      function formatPairCode(code) {
        const clean = String(code || '').replace(/[^A-Z0-9]/gi, '').toUpperCase();
        return clean.match(/.{1,4}/g)?.join('-') || clean;
      }

      pairBtn.addEventListener('click', async () => {
        hideAlert();
        pairResult.classList.add('hidden');

        const sessionId = (sessionInput.value || 'default').trim() || 'default';
        const validation = validatePhone(phoneInput.value);

        if (!validation.ok) {
          showAlert(validation.message, 'error');
          phoneInput.focus();
          return;
        }

        setPairLoading(true);
        showAlert('Inatuma ombi kwa seva...', 'info');

        try {
          const res = await fetch(`/api/sessions/${encodeURIComponent(sessionId)}/pair`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({ phoneNumber: validation.clean }),
          });

          let data;
          try {
            data = await res.json();
          } catch (_) {
            throw new Error('Seva ilirudisha jibu lisilo sahihi.');
          }

          if (!res.ok || !data.success) {
            const msg = data?.message || data?.error || `Hitilafu (${res.status})`;
            throw new Error(msg);
          }

          const code = data.code || data.pairCode || data.data?.code;
          if (!code) throw new Error('Hakuna code iliyorudishwa na seva.');

          currentCode = formatPairCode(code);
          pairCodeValue.textContent = currentCode;
          pairResult.classList.remove('hidden');

          showAlert('Pairing Code imepokelewa! Weka kwenye WhatsApp yako.', 'success');

          setTimeout(() => {
            pairResult.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }, 200);
        } catch (err) {
          showAlert(err?.message || 'Hitilafu isiyojulikana.', 'error');
        } finally {
          setPairLoading(false);
        }
      });

      // Enter key on phone input
      phoneInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          pairBtn.click();
        }
      });

      // Sanitize: digits only
      phoneInput.addEventListener('input', (e) => {
        e.target.value = e.target.value.replace(/[^\d]/g, '');
      });

      // ============================================
      //  COPY CODE
      // ============================================
      copyCodeBtn.addEventListener('click', async () => {
        if (!currentCode) return;
        const plain = currentCode.replace(/-/g, '');
        let ok = false;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(plain);
            ok = true;
          } else {
            const ta = document.createElement('textarea');
            ta.value = plain;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            ok = true;
          }
        } catch (_) {
          ok = false;
        }

        if (ok) {
          copyCodeBtn.classList.add('border-green-500/50', 'bg-green-500/15');
          copyIcon.textContent = '✅';
          copyLabel.textContent = 'Copied!';
          setTimeout(() => {
            copyCodeBtn.classList.remove('border-green-500/50', 'bg-green-500/15');
            copyIcon.textContent = '📋';
            copyLabel.textContent = 'Copy Code';
          }, 2200);
        } else {
          showAlert('Imeshindwa kunakili. Nakili kwa mkono.', 'warn');
        }
      });

      // ============================================
      //  QR CODE RENDERER
      // ============================================
      function renderQR(qrText) {
        if (!qrText) return;

        // Clear placeholder
        if (qrPlaceholder && qrPlaceholder.parentNode) {
          qrPlaceholder.remove();
        }

        // Reset container
        qrContainer.innerHTML = '';

        try {
          qrInstance = new QRCode(qrContainer, {
            text: qrText,
            width: 260,
            height: 260,
            colorDark: '#0a0a1a',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M,
          });
        } catch (err) {
          qrContainer.innerHTML = `
            <div class="text-center text-red-400 text-sm">
              ❌ Imeshindwa kutengeneza QR code
            </div>
          `;
        }
      }

      // ============================================
      //  STATUS BAR
      // ============================================
      function setStatus(online, sessionId) {
        if (online) {
          statusDot.className =
            'relative w-2.5 h-2.5 rounded-full bg-green-500 pulse-ring';
          statusText.textContent = 'Online';
          statusText.className = 'text-sm font-semibold text-green-400 leading-none';
        } else {
          statusDot.className =
            'relative w-2.5 h-2.5 rounded-full bg-red-500 pulse-ring-off';
          statusText.textContent = 'Offline';
          statusText.className = 'text-sm font-semibold text-red-400 leading-none';
        }
        if (sessionId) {
          statusSession.textContent = sessionId;
        }
      }

      // ============================================
      //  WEBSOCKET
      // ============================================
      function ensureWebSocket() {
        if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) {
          return;
        }
        connectWebSocket();
      }

      function connectWebSocket() {
        // Determine protocol (ws/wss based on page)
        const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const wsUrl = `${proto}//${window.location.host}/ws`;

        try {
          ws = new WebSocket(wsUrl);
        } catch (err) {
          console.error('[WS] Failed to create:', err);
          scheduleReconnect();
          return;
        }

        ws.addEventListener('open', () => {
          console.log('[WS] Connected');
          reconnectDelay = 1500;

          const sessionId = (sessionInput.value || 'default').trim() || 'default';
          sendWS({
            type: 'subscribe',
            sessionId,
          });
        });

        ws.addEventListener('message', (evt) => {
          let payload;
          try {
            payload = JSON.parse(evt.data);
          } catch (_) {
            return;
          }
          handleWSMessage(payload);
        });

        ws.addEventListener('close', () => {
          console.log('[WS] Disconnected');
          setStatus(false);
          scheduleReconnect();
        });

        ws.addEventListener('error', (err) => {
          console.warn('[WS] Error:', err.message || err);
        });
      }

      function sendWS(obj) {
        if (!ws || ws.readyState !== WebSocket.OPEN) return false;
        try {
          ws.send(JSON.stringify(obj));
          return true;
        } catch (_) {
          return false;
        }
      }

      function scheduleReconnect() {
        if (reconnectTimer) return;
        reconnectTimer = setTimeout(() => {
          reconnectTimer = null;
          reconnectDelay = Math.min(reconnectDelay * 1.5, 15000);
          connectWebSocket();
        }, reconnectDelay);
      }

      // ============================================
      //  WS MESSAGE HANDLER
      // ============================================
      function handleWSMessage(data) {
        if (!data || typeof data !== 'object') return;

        const type = data.type || data.event;

        // ---------- QR CODE ----------
        if (type === 'qr') {
          const qrText = data.qr || data.data?.qr || data.code;
          if (qrText) {
            // Auto-switch to QR tab
            if (currentTab !== 'qr') setTab('qr');
            renderQR(qrText);
          }
          return;
        }

        // ---------- CONNECTION STATUS ----------
        if (type === 'connected' || type === 'open' || type === 'ready') {
          setStatus(true, data.sessionId);
          showAlert('Session imeunganishwa kikamilifu! ✅', 'success');
          return;
        }

        if (type === 'disconnected' || type === 'close' || type === 'offline') {
          setStatus(false, data.sessionId);
          showAlert('Session imekatika. Inajaribu kuunganisha tena...', 'warn');
          return;
        }

        if (type === 'pair-success' || type === 'pairing-success') {
          showAlert('Pairing imefanikiwa! Subiri WhatsApp iunganishe...', 'success');
          return;
        }

        if (type === 'error') {
          showAlert(data.message || 'Hitilafu kutoka WebSocket.', 'error');
          return;
        }

        // ---------- LOGS (optional) ----------
        if (type === 'log' && data.message) {
          console.log('[Server Log]', data.message);
        }
      }

      // ============================================
      //  SESSION CHANGE
      // ============================================
      sessionInput.addEventListener('change', () => {
        const sessionId = (sessionInput.value || 'default').trim() || 'default';
        statusSession.textContent = sessionId;
        sendWS({ type: 'subscribe', sessionId });
      });

      // ============================================
      //  INITIALIZE
      // ============================================
      window.addEventListener('load', () => {
        setTab('pair');
        setStatus(false);
        statusSession.textContent = (sessionInput.value || 'default').trim() || 'default';
        ensureWebSocket();
      });

      // Cleanup on unload
      window.addEventListener('beforeunload', () => {
        if (ws) {
          try { ws.close(); } catch (_) {}
        }
      });
    })();
  </script>

</body>
</html>
