<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0a0a1a" />
  <title><%= typeof title !== 'undefined' ? title : 'WhatsApp Bot Pairing' %></title>
  <style>
    /* ================================================
       RESET & BASE
       ================================================ */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg-1: #0a0a1a;
      --bg-2: #12122a;
      --bg-3: #1a1a3a;
      --card-bg: rgba(255, 255, 255, 0.04);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-hover: rgba(96, 165, 250, 0.4);
      --accent-1: #3b82f6;
      --accent-2: #60a5fa;
      --accent-3: #06b6d4;
      --accent-glow: rgba(59, 130, 246, 0.5);
      --text: #f1f5f9;
      --text-dim: #94a3b8;
      --text-mute: #64748b;
      --success: #22c55e;
      --success-bg: rgba(34, 197, 94, 0.12);
      --error: #ef4444;
      --error-bg: rgba(239, 68, 68, 0.12);
      --warn: #f59e0b;
      --warn-bg: rgba(245, 158, 11, 0.12);
      --info-bg: rgba(59, 130, 246, 0.12);
      --radius: 18px;
      --radius-sm: 12px;
      --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.5);
      --shadow-glow: 0 12px 40px rgba(59, 130, 246, 0.35);
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html, body {
      min-height: 100vh;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
                   Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg-1);
      color: var(--text);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    /* ================================================
       ANIMATED BACKGROUND
       ================================================ */
    .bg-layer {
      position: fixed;
      inset: 0;
      z-index: -2;
      background:
        radial-gradient(ellipse at top left, #1a1a3a 0%, transparent 50%),
        radial-gradient(ellipse at bottom right, #0a1a2a 0%, transparent 50%),
        linear-gradient(180deg, #0a0a1a 0%, #0d0d20 100%);
    }

    .bg-orbs {
      position: fixed;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      pointer-events: none;
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.5;
      animation: float 18s ease-in-out infinite;
    }

    .orb-1 {
      width: 480px;
      height: 480px;
      background: radial-gradient(circle, #3b82f6, transparent 70%);
      top: -140px;
      left: -120px;
      animation-delay: 0s;
    }

    .orb-2 {
      width: 420px;
      height: 420px;
      background: radial-gradient(circle, #06b6d4, transparent 70%);
      bottom: -140px;
      right: -120px;
      animation-delay: -6s;
    }

    .orb-3 {
      width: 360px;
      height: 360px;
      background: radial-gradient(circle, #6366f1, transparent 70%);
      top: 45%;
      left: 55%;
      animation-delay: -12s;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(40px, -30px) scale(1.08); }
      66% { transform: translate(-30px, 25px) scale(0.95); }
    }

    /* Grid overlay */
    .grid-overlay {
      position: fixed;
      inset: 0;
      z-index: -1;
      background-image:
        linear-gradient(rgba(96, 165, 250, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(96, 165, 250, 0.05) 1px, transparent 1px);
      background-size: 50px 50px;
      mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
      pointer-events: none;
    }

    /* ================================================
       LAYOUT
       ================================================ */
    .wrap {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .container {
      width: 100%;
      max-width: 480px;
      animation: slideUp 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ================================================
       LOGO / BRAND
       ================================================ */
    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 32px;
      animation: fadeIn 0.9s ease 0.1s both;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .brand-icon {
      width: 76px;
      height: 76px;
      border-radius: 22px;
      background: linear-gradient(135deg, var(--accent-1), var(--accent-3));
      display: grid;
      place-items: center;
      font-size: 2.2rem;
      margin-bottom: 20px;
      box-shadow:
        0 12px 40px var(--accent-glow),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      animation: pulse 3s ease-in-out infinite;
      position: relative;
    }

    .brand-icon::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 26px;
      background: linear-gradient(135deg, var(--accent-1), var(--accent-3));
      opacity: 0.35;
      filter: blur(16px);
      z-index: -1;
      animation: pulseGlow 3s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    @keyframes pulseGlow {
      0%, 100% { opacity: 0.35; }
      50% { opacity: 0.6; }
    }

    .brand h1 {
      font-size: clamp(1.6rem, 5vw, 2rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      text-align: center;
      background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 10px;
    }

    .brand p {
      color: var(--text-dim);
      font-size: 0.92rem;
      text-align: center;
      max-width: 340px;
      line-height: 1.6;
    }

    /* ================================================
       CARD
       ================================================ */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 32px 28px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: var(--shadow-lg);
      position: relative;
      overflow: hidden;
      animation: fadeIn 0.9s ease 0.2s both;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 15%;
      right: 15%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent,
        rgba(96, 165, 250, 0.7),
        transparent);
    }

    /* ================================================
       FORM
       ================================================ */
    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-dim);
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .input-wrap {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.1rem;
      opacity: 0.7;
      pointer-events: none;
      transition: opacity var(--transition);
    }

    .input-field {
      width: 100%;
      padding: 15px 18px 15px 46px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-sm);
      color: var(--text);
      font-size: 1rem;
      font-family: inherit;
      outline: none;
      transition: all var(--transition);
      letter-spacing: 0.02em;
    }

    .input-field::placeholder {
      color: var(--text-mute);
      letter-spacing: 0;
    }

    .input-field:focus {
      border-color: var(--accent-1);
      background: rgba(59, 130, 246, 0.08);
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
    }

    .input-field:focus + .input-icon,
    .input-field:not(:placeholder-shown) + .input-icon {
      opacity: 1;
    }

    .input-field:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* ================================================
       BUTTONS
       ================================================ */
    .btn {
      width: 100%;
      padding: 15px 24px;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 1rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all var(--transition);
      position: relative;
      overflow: hidden;
      letter-spacing: 0.02em;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent-1), var(--accent-3));
      color: #fff;
      box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #6366f1, var(--accent-1));
      opacity: 0;
      transition: opacity var(--transition);
    }

    .btn-primary:hover:not(:disabled)::before {
      opacity: 1;
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 14px 34px rgba(59, 130, 246, 0.6);
    }

    .btn-primary:active:not(:disabled) {
      transform: translateY(0);
    }

    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      box-shadow: 0 6px 18px rgba(59, 130, 246, 0.25);
    }

    .btn-primary .btn-text,
    .btn-primary .btn-spinner {
      position: relative;
      z-index: 1;
    }

    /* Spinner */
    .btn-spinner {
      width: 18px;
      height: 18px;
      border: 2.5px solid rgba(255, 255, 255, 0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    .btn.loading .btn-spinner {
      display: block;
    }

    .btn.loading .btn-icon {
      display: none;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* ================================================
       ALERTS
       ================================================ */
    .alert {
      padding: 14px 18px;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      line-height: 1.55;
      margin-bottom: 18px;
      display: none;
      align-items: flex-start;
      gap: 10px;
      animation: alertIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes alertIn {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .alert.show {
      display: flex;
    }

    .alert-icon {
      font-size: 1.05rem;
      flex-shrink: 0;
      line-height: 1.4;
    }

    .alert-body {
      flex: 1;
      word-break: break-word;
    }

    .alert-error {
      background: var(--error-bg);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    .alert-success {
      background: var(--success-bg);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #86efac;
    }

    .alert-info {
      background: var(--info-bg);
      border: 1px solid rgba(59, 130, 246, 0.3);
      color: #93c5fd;
    }

    .alert-warn {
      background: var(--warn-bg);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #fcd34d;
    }

    /* ================================================
       CODE RESULT BOX
       ================================================ */
    .code-box {
      display: none;
      margin-top: 22px;
      padding: 22px 20px;
      background: rgba(59, 130, 246, 0.08);
      border: 1.5px dashed rgba(96, 165, 250, 0.5);
      border-radius: var(--radius-sm);
      text-align: center;
      animation: codeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes codeIn {
      from {
        opacity: 0;
        transform: scale(0.95);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .code-box.show {
      display: block;
    }

    .code-box-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 14px;
    }

    .pair-code {
      display: inline-block;
      padding: 14px 24px;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 12px;
      font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
      font-size: clamp(1.3rem, 5vw, 1.8rem);
      font-weight: 800;
      letter-spacing: 0.15em;
      color: #93c5fd;
      margin-bottom: 16px;
      user-select: all;
      animation: codePulse 2.5s ease-in-out infinite;
    }

    @keyframes codePulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.03); }
    }

    .copy-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 22px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      color: var(--text);
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition);
    }

    .copy-btn:hover {
      background: rgba(96, 165, 250, 0.18);
      border-color: rgba(96, 165, 250, 0.4);
      transform: translateY(-1px);
    }

    .copy-btn:active {
      transform: translateY(0);
    }

    .copy-btn.copied {
      background: rgba(34, 197, 94, 0.18);
      border-color: rgba(34, 197, 94, 0.45);
      color: #86efac;
    }

    /* ================================================
       INSTRUCTIONS
       ================================================ */
    .instructions {
      margin-top: 22px;
      padding: 18px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: var(--radius-sm);
      animation: fadeIn 0.9s ease 0.4s both;
    }

    .instructions-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #93c5fd;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 14px;
    }

    .step {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 7px 0;
      font-size: 0.88rem;
      color: var(--text-dim);
      line-height: 1.55;
    }

    .step-num {
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(59, 130, 246, 0.2);
      color: #93c5fd;
      display: grid;
      place-items: center;
      font-size: 0.75rem;
      font-weight: 700;
      margin-top: 1px;
    }

    /* ================================================
       FOOTER
       ================================================ */
    .footer {
      margin-top: 28px;
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-mute);
      animation: fadeIn 0.9s ease 0.5s both;
    }

    .footer a {
      color: var(--accent-2);
      text-decoration: none;
      transition: color var(--transition);
    }

    .footer a:hover {
      color: var(--accent-3);
      text-decoration: underline;
    }

    /* ================================================
       RESPONSIVE
       ================================================ */
    @media (max-width: 520px) {
      .wrap {
        padding: 24px 16px;
      }
      .card {
        padding: 26px 20px;
      }
      .brand-icon {
        width: 64px;
        height: 64px;
        font-size: 1.9rem;
        border-radius: 18px;
      }
      .brand h1 {
        font-size: 1.4rem;
      }
      .pair-code {
        padding: 12px 18px;
        letter-spacing: 0.12em;
      }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Animated background -->
  <div class="bg-layer"></div>
  <div class="bg-orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>
  <div class="grid-overlay"></div>

  <div class="wrap">
    <div class="container">

      <!-- Brand / Header -->
      <div class="brand">
        <div class="brand-icon">🔗</div>
        <h1>WhatsApp Bot Pairing</h1>
        <p>
          Weka namba yako ya simu na nchi
          <br />
          <span style="color: #93c5fd; font-weight: 600;">
            (mfano: 255712345678)
          </span>
        </p>
      </div>

      <!-- Card -->
      <div class="card">

        <!-- Alert area -->
        <div id="alertBox" class="alert"></div>

        <!-- Form -->
        <form id="pairForm" autocomplete="off">
          <div class="form-group">
            <label class="form-label" for="phoneNumber">
              Namba ya Simu
            </label>
            <div class="input-wrap">
              <input
                type="tel"
                id="phoneNumber"
                class="input-field"
                placeholder="255712345678"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength="15"
                required
              />
              <span class="input-icon">📱</span>
            </div>
          </div>

          <button type="submit" id="submitBtn" class="btn btn-primary">
            <span class="btn-spinner"></span>
            <span class="btn-icon">🔑</span>
            <span class="btn-text">Pata Pairing Code</span>
          </button>
        </form>

        <!-- Pairing Code Display -->
        <div id="codeBox" class="code-box">
          <div class="code-box-label">Pairing Code</div>
          <div id="pairCodeText" class="pair-code">----</div>
          <div>
            <button type="button" id="copyBtn" class="copy-btn">
              <span id="copyIcon">📋</span>
              <span id="copyLabel">Copy Code</span>
            </button>
          </div>
        </div>

        <!-- Instructions -->
        <div class="instructions">
          <div class="instructions-title">
            <span>📖</span>
            <span>Jinsi ya Kutumia</span>
          </div>
          <div class="step">
            <span class="step-num">1</span>
            <span>Fungua WhatsApp kwenye simu yako</span>
          </div>
          <div class="step">
            <span class="step-num">2</span>
            <span>Nenda <strong>Settings → Linked Devices</strong></span>
          </div>
          <div class="step">
            <span class="step-num">3</span>
            <span>Bonyeza <strong>Link a Device</strong></span>
          </div>
          <div class="step">
            <span class="step-num">4</span>
            <span>Chagua <strong>Link with phone number</strong></span>
          </div>
          <div class="step">
            <span class="step-num">5</span>
            <span>Weka code uliyopewa hapo juu</span>
          </div>
        </div>

      </div>

      <!-- Footer -->
      <div class="footer">
        Powered by <a href="/">Dvary Bot</a> · Secured &amp; Encrypted
      </div>

    </div>
  </div>

  <script>
    /* ================================================
       ELEMENTS
       ================================================ */
    const form       = document.getElementById('pairForm');
    const phoneInput = document.getElementById('phoneNumber');
    const submitBtn  = document.getElementById('submitBtn');
    const btnText    = submitBtn.querySelector('.btn-text');
    const alertBox   = document.getElementById('alertBox');
    const codeBox    = document.getElementById('codeBox');
    const codeText   = document.getElementById('pairCodeText');
    const copyBtn    = document.getElementById('copyBtn');
    const copyIcon   = document.getElementById('copyIcon');
    const copyLabel  = document.getElementById('copyLabel');

    let currentCode = '';

    /* ================================================
       ALERT HELPERS
       ================================================ */
    function showAlert(message, type = 'info') {
      const icons = {
        error: '❌',
        success: '✅',
        info: 'ℹ️',
        warn: '⚠️'
      };
      alertBox.innerHTML =
        `<span class="alert-icon">${icons[type] || 'ℹ️'}</span>` +
        `<span class="alert-body">${escapeHtml(message)}</span>`;
      alertBox.className = `alert alert-${type} show`;
    }

    function hideAlert() {
      alertBox.className = 'alert';
      alertBox.innerHTML = '';
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    }

    /* ================================================
       LOADING STATE
       ================================================ */
    function setLoading(loading) {
      if (loading) {
        submitBtn.classList.add('loading');
        submitBtn.disabled = true;
        btnText.textContent = 'Inatuma...';
        phoneInput.disabled = true;
      } else {
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
        btnText.textContent = 'Pata Pairing Code';
        phoneInput.disabled = false;
      }
    }

    /* ================================================
       FORMAT CODE (XXXX-XXXX)
       ================================================ */
    function formatCode(code) {
      const clean = String(code).replace(/[^A-Z0-9]/gi, '').toUpperCase();
      return clean.match(/.{1,4}/g)?.join('-') || clean;
    }

    /* ================================================
       PHONE VALIDATION
       ================================================ */
    function validatePhone(phone) {
      const clean = String(phone).replace(/[^\d]/g, '');
      if (!clean) return { ok: false, message: 'Weka namba yako ya simu.' };
      if (clean.length < 8) return { ok: false, message: 'Namba ni fupi sana (min 8 digits).' };
      if (clean.length > 15) return { ok: false, message: 'Namba ni ndefu sana (max 15 digits).' };
      return { ok: true, clean };
    }

    /* ================================================
       SUBMIT FORM (AJAX)
       ================================================ */
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();
      codeBox.classList.remove('show');
      currentCode = '';

      // Validate
      const validation = validatePhone(phoneInput.value);
      if (!validation.ok) {
        showAlert(validation.message, 'error');
        phoneInput.focus();
        return;
      }

      setLoading(true);
      showAlert('Inatuma ombi kwa seva...', 'info');

      try {
        const res = await fetch('/api/pair', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            phoneNumber: validation.clean
          })
        });

        let data;
        try {
          data = await res.json();
        } catch (_) {
          throw new Error('Seva ilirudisha jibu lisilo sahihi.');
        }

        if (!res.ok || !data.success) {
          const msg = data?.message || data?.error || `Hitilafu (${res.status})`;
          throw new Error(msg);
        }

        // Success
        const code = data.code || data.pairCode || data.data?.code;
        if (!code) {
          throw new Error('Hakuna code iliyorudishwa na seva.');
        }

        currentCode = formatCode(code);
        codeText.textContent = currentCode;
        codeBox.classList.add('show');
        showAlert('Code imepokelewa! Weka kwenye WhatsApp yako.', 'success');

        // Scroll to code
        setTimeout(() => {
          codeBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 250);

      } catch (err) {
        const message = err?.message || 'Hitilafu isiyojulikana. Jaribu tena.';
        showAlert(message, 'error');
      } finally {
        setLoading(false);
      }
    });

    /* ================================================
       COPY BUTTON
       ================================================ */
    copyBtn.addEventListener('click', async () => {
      if (!currentCode) return;

      const plain = currentCode.replace(/-/g, '');
      let ok = false;

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(plain);
          ok = true;
        } else {
          // Fallback for non-secure contexts
          const ta = document.createElement('textarea');
          ta.value = plain;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          ta.style.pointerEvents = 'none';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          ok = true;
        }
      } catch (_) {
        ok = false;
      }

      if (ok) {
        copyBtn.classList.add('copied');
        copyIcon.textContent = '✅';
        copyLabel.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyIcon.textContent = '📋';
          copyLabel.textContent = 'Copy Code';
        }, 2200);
      } else {
        showAlert('Imeshindwa kunakili. Tafadhali nakili kwa mkono.', 'warn');
      }
    });

    /* ================================================
       AUTO-FOCUS & INPUT SANITIZATION
       ================================================ */
    window.addEventListener('load', () => {
      setTimeout(() => phoneInput.focus(), 400);
    });

    phoneInput.addEventListener('input', (e) => {
      // Allow only digits
      e.target.value = e.target.value.replace(/[^\d]/g, '');
    });

    phoneInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        form.requestSubmit ? form.requestSubmit() : form.submit();
      }
    });
  </script>

</body>
</html>
